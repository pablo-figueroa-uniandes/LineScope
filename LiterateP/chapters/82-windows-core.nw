@ The specification is a [[readonly record struct]], so it compares and hashes by value, as the
Swift [[Hashable]] struct did. Its positional constructor takes all four
values. A second constructor supplies the defaults and a nullable parameter, which becomes the
kind's default, like Swift's [[parameter: Double? = nil]]; a call with a [[double]] for the last
argument picks the positional constructor, one without it the second. [[Clamped]] is new in the
port; it forces the parameter into its range with [[with]], which copies a record and changes one
field.

<<Win TestPattern: specification>>=
public readonly record struct TestPatternSpec(TestPatternKind Kind, int Width, int Height, double Parameter)
{
    public TestPatternSpec(TestPatternKind kind, int width = 512, int height = 512, double? parameter = null)
        : this(kind, width, height, parameter ?? kind.Parameter()?.DefaultValue ?? 0) { }

    public string Title
    {
        get
        {
            var t = $"{Kind.DisplayName()} {Width}×{Height}";
            var p = Kind.Parameter();
            if (p is not null && (Kind != TestPatternKind.WhiteNoise || Parameter != p.DefaultValue))
                t += $" ({Fmt.Number(Parameter)})";
            return t;
        }
    }

    /// <summary>The spec with its parameter clamped to the kind's range.</summary>
    public TestPatternSpec Clamped()
    {
        var p = Kind.Parameter();
        return p is null ? this : this with { Parameter = p.Clamp(Parameter) };
    }
}
