@ Dispatch is one switch expression. The five former Core Image filters go through
[[Premultiplied]]; the rest are unchanged from Chapter~\ref{ch:filters}, kernels included.

<<Win Filters: dispatching a filter>>=
public static PixelBuffer Apply(FilterKind filter, PixelBuffer src) => filter switch
{
    FilterKind.GaussianBlur g => Premultiplied(src, p => GaussianBlur(p, src.Width, src.Height, g.Radius)),
    FilterKind.BoxBlur b => Premultiplied(src, p => BoxBlur(p, src.Width, src.Height, b.Radius)),
    FilterKind.Median => Premultiplied(src, p => Median3x3(p, src.Width, src.Height)),
    FilterKind.UnsharpMask u => Premultiplied(src, p => UnsharpMask(p, src.Width, src.Height, u.Radius, u.Intensity)),
    FilterKind.NoiseReduction n => Premultiplied(src, p => NoiseReduction(p, src.Width, src.Height, n.Level, n.Sharpness)),
    FilterKind.Sobel => Sobel(src),
    // Absolute response so the edges are visible.
    FilterKind.Laplacian => Convolve3x3(src, [0, 1, 0, 1, -4, 1, 0, 1, 0], absolute: true),
    FilterKind.Emboss => Convolve3x3(src, [-2, -1, 0, -1, 1, 1, 0, 1, 2], absolute: false),
    FilterKind.Grayscale => MapRgb(src, c =>
    {
        float y = 0.2126f * c.R + 0.7152f * c.G + 0.0722f * c.B;
        return new Rgba(y, y, y, c.A);
    }),
    FilterKind.Invert => MapRgb(src, c => new Rgba(1 - c.R, 1 - c.G, 1 - c.B, c.A)),
    _ => src,
};
@ This helper is what is left of the Core Image bridge. The Swift [[applyCI]] premultiplied the
buffer, wrapped it as a [[CIImage]] without a color space, filtered, and un-premultiplied the
result. Here the filter is simply a function from premultiplied floats to premultiplied floats.
Both halves of the Core Image setup that mattered survive in spirit: there is no color
management, because nothing here knows about color spaces, and the edges are clamped, as
[[clampedToExtent]] did, by the index clamping in every loop below.

<<Win Filters: running on premultiplied data>>=
private static PixelBuffer Premultiplied(PixelBuffer src, Func<float[], float[]> body) =>
    PixelBuffer.FromPremultiplied(src.Width, src.Height, body(src.Premultiplied()));
@ \subsection{Separable blurs}

Both blurs convolve with a symmetric one-dimensional kernel, first along the rows and then along
the columns, like the resampler (Chapter~\ref{ch:resampling}). Unlike the resampler, the image
keeps its size, and a tap that falls outside the image reads the nearest border pixel. The two
passes are parallel over rows, and each pass writes a fresh array, so no iteration reads what
another one writes.

<<Win Filters: separable convolution>>=
/// <summary>Convolves every channel with a symmetric 1-D kernel (index <c>radius</c> is the center) along x, then y.</summary>
internal static float[] ConvolveSeparable(float[] src, int w, int h, float[] kernel)
{
    int r = kernel.Length / 2;
    var tmp = new float[src.Length];
    Parallel.For(0, h, y =>
    {
        for (int x = 0; x < w; x++)
        {
            float a0 = 0, a1 = 0, a2 = 0, a3 = 0;
            for (int k = -r; k <= r; k++)
            {
                int xx = Math.Clamp(x + k, 0, w - 1);
                int i = (y * w + xx) * 4;
                float wt = kernel[k + r];
                a0 += src[i] * wt; a1 += src[i + 1] * wt; a2 += src[i + 2] * wt; a3 += src[i + 3] * wt;
            }
            int o = (y * w + x) * 4;
            tmp[o] = a0; tmp[o + 1] = a1; tmp[o + 2] = a2; tmp[o + 3] = a3;
        }
    });
    var output = new float[src.Length];
    Parallel.For(0, h, y =>
    {
        for (int x = 0; x < w; x++)
        {
            float a0 = 0, a1 = 0, a2 = 0, a3 = 0;
            for (int k = -r; k <= r; k++)
            {
                int yy = Math.Clamp(y + k, 0, h - 1);
                int i = (yy * w + x) * 4;
                float wt = kernel[k + r];
                a0 += tmp[i] * wt; a1 += tmp[i + 1] * wt; a2 += tmp[i + 2] * wt; a3 += tmp[i + 3] * wt;
            }
            int o = (y * w + x) * 4;
            output[o] = a0; output[o + 1] = a1; output[o + 2] = a2; output[o + 3] = a3;
        }
    });
    return output;
}
@ Apple documents the radius of [[CIGaussianBlur]] as the standard deviation of the Gaussian,
so the port takes $\sigma = r$. The kernel
\[
  g_i = \frac{e^{-i^2/2\sigma^2}}{\sum_{j=-R}^{R} e^{-j^2/2\sigma^2}},
  \qquad |i| \le R = \max\bigl(1, \lceil 3\sigma\rceil\bigr),
\]
is truncated at $3\sigma$, where the Gaussian has fallen to about $1\%$ of its peak and the
omitted tails hold less than $0.3\%$ of its mass; dividing by the sum restores the rest, so a flat
image stays flat. A radius below $10^{-3}$ is the identity.

<<Win Filters: the Gaussian kernel>>=
internal static float[] GaussianKernel(double sigma)
{
    if (sigma < 1e-3) return [1];
    int r = Math.Max(1, (int)Math.Ceiling(3 * sigma));
    var k = new float[2 * r + 1];
    double sum = 0;
    for (int i = -r; i <= r; i++)
    {
        double v = Math.Exp(-(i * i) / (2 * sigma * sigma));
        k[i + r] = (float)v;
        sum += v;
    }
    for (int i = 0; i < k.Length; i++) k[i] = (float)(k[i] / sum);
    return k;
}
@ The box blur must accept fractional radii, since the parameter sheet does. The port treats the
box as the continuous interval $[-(r+\frac12),\ r+\frac12]$ and weights each tap $i$ by the part of
its pixel $[i-\frac12, i+\frac12]$ that the interval covers. This is the area-averaging rule of
Chapter~\ref{ch:resampling} applied to a filter. With $r = 1$ the box covers three whole pixels,
with $r = 0$ it is the identity, and with $r = 1.5$ the weights are
$\frac14(\frac12, 1, 1, 1, \frac12)$, so the result changes smoothly as the radius does.

<<Win Filters: the box kernel>>=
internal static float[] BoxKernel(double radius)
{
    double half = Math.Max(radius, 0) + 0.5;
    int r = (int)Math.Ceiling(half - 0.5);
    var k = new float[2 * r + 1];
    double sum = 0;
    for (int i = -r; i <= r; i++)
    {
        double overlap = Math.Min(i + 0.5, half) - Math.Max(i - 0.5, -half);
        k[i + r] = (float)Math.Max(0, overlap);
        sum += k[i + r];
    }
    for (int i = 0; i < k.Length; i++) k[i] = (float)(k[i] / sum);
    return k;
}
@
<<Win Filters: the two blurs>>=
private static float[] GaussianBlur(float[] p, int w, int h, double radius) =>
    ConvolveSeparable(p, w, h, GaussianKernel(radius));

private static float[] BoxBlur(float[] p, int w, int h, double radius) =>
    ConvolveSeparable(p, w, h, BoxKernel(radius));
@ \subsection{Sharpening, median and noise reduction}

The unsharp mask is the formula of Chapter~\ref{ch:filters},
$\mathit{out} = \mathit{src} + \mathit{intensity}\times(\mathit{src} - G_r * \mathit{src})$, with
the Gaussian just defined. It is applied to the three premultiplied color components; alpha is
copied, so sharpening never makes an opaque image partly transparent. Overshoot is left in the
result and clamped when the buffer is un-premultiplied.

<<Win Filters: unsharp mask>>=
private static float[] UnsharpMask(float[] p, int w, int h, double radius, double intensity)
{
    var blurred = GaussianBlur(p, w, h, radius);
    float amount = (float)intensity;
    var output = new float[p.Length];
    for (int i = 0; i < p.Length; i += 4)
    {
        for (int c = 0; c < 3; c++)
            output[i + c] = p[i + c] + amount * (p[i + c] - blurred[i + c]);
        output[i + 3] = p[i + 3];
    }
    return output;
}
@ The median takes, for each channel separately, the middle one of the nine values in the
$3\times3$ neighborhood. Sorting nine floats is fast enough; the only care taken is not to
allocate the nine-element window once per pixel. The overload of [[Parallel.For]] with
thread-local state gives every worker thread its own window, created once by the [[localInit]] delegate
and passed from one row to the next.

<<Win Filters: [[3x3]] median>>=
private static float[] Median3x3(float[] p, int w, int h)
{
    var output = new float[p.Length];
    Parallel.For(0, h, () => new float[9], (y, _, window) =>
    {
        for (int x = 0; x < w; x++)
        {
            int o = (y * w + x) * 4;
            for (int c = 0; c < 4; c++)
            {
                int n = 0;
                for (int ky = -1; ky <= 1; ky++)
                {
                    int yy = Math.Clamp(y + ky, 0, h - 1);
                    for (int kx = -1; kx <= 1; kx++)
                    {
                        int xx = Math.Clamp(x + kx, 0, w - 1);
                        window[n++] = p[(yy * w + xx) * 4 + c];
                    }
                }
                Array.Sort(window);
                output[o + c] = window[4];
            }
        }
        return window;
    }, _ => { });
    return output;
}
@ Core Image's noise reduction is documented only in words: changes in luminance smaller than the
noise level count as noise and are smoothed, larger ones count as edges and are sharpened by the
sharpness amount. The port implements that description as a \emph{threshold} (or ``sigma'')
filter on the $3\times3$ neighborhood. It first computes the Rec.~709 luma of every pixel, with
the grayscale filter's weights.

<<Win Filters: noise reduction>>=
private static float[] NoiseReduction(float[] p, int w, int h, double level, double sharpness)
{
    float threshold = (float)level;
    float amount = (float)sharpness;
    var luma = new float[w * h];
    for (int i = 0; i < luma.Length; i++)
        luma[i] = 0.2126f * p[i * 4] + 0.7152f * p[i * 4 + 1] + 0.0722f * p[i * 4 + 2];

    var output = new float[p.Length];
    Parallel.For(0, h, y =>
    {
        for (int x = 0; x < w; x++)
        {
            <<Win Filters: noise reduction, scanning the neighborhood>>
            <<Win Filters: noise reduction, smoothing or sharpening>>
        }
    });
    return output;
}
@ One pass over the nine neighbors gathers two sums: [[m]], of all of them, and [[s]], of those
whose luma is within the threshold of the center's. A neighbor outside the threshold marks the
pixel as lying on an edge.

<<Win Filters: noise reduction, scanning the neighborhood>>=
int ci = y * w + x;
float center = luma[ci];
bool edge = false;
float s0 = 0, s1 = 0, s2 = 0, s3 = 0;
float m0 = 0, m1 = 0, m2 = 0, m3 = 0;
int count = 0;
for (int ky = -1; ky <= 1; ky++)
{
    int yy = Math.Clamp(y + ky, 0, h - 1);
    for (int kx = -1; kx <= 1; kx++)
    {
        int xx = Math.Clamp(x + kx, 0, w - 1);
        int ni = yy * w + xx;
        int i = ni * 4;
        m0 += p[i]; m1 += p[i + 1]; m2 += p[i + 2]; m3 += p[i + 3];
        if (MathF.Abs(luma[ni] - center) < threshold)
        {
            s0 += p[i]; s1 += p[i + 1]; s2 += p[i + 2]; s3 += p[i + 3];
            count++;
        }
        else
        {
            edge = true;
        }
    }
}
@ An edge pixel is sharpened by an unsharp mask whose blur is the $3\times3$ mean,
$\mathit{out} = p + \mathit{sharpness}\times(p - \bar m)$, with alpha kept. Any other pixel is
replaced by the mean of the neighbors within the threshold. Because smoothing happens only when
\emph{no} neighbor crossed the threshold, that mean is in practice over all nine; the count is kept
so that the division is safe whatever the test says. A noise level of $0$ makes every pixel an
edge, so the filter becomes a pure sharpener, and a large level turns it into a $3\times3$ box blur.

<<Win Filters: noise reduction, smoothing or sharpening>>=
int o = ci * 4;
if (edge || count == 0)
{
    // Edge: unsharp mask against the 3×3 mean.
    output[o] = p[o] + amount * (p[o] - m0 / 9);
    output[o + 1] = p[o + 1] + amount * (p[o + 1] - m1 / 9);
    output[o + 2] = p[o + 2] + amount * (p[o + 2] - m2 / 9);
    output[o + 3] = p[o + 3];
}
else
{
    output[o] = s0 / count;
    output[o + 1] = s1 / count;
    output[o + 2] = s2 / count;
    output[o + 3] = s3 / count;
}
@ \subsection{Why the results differ from macOS}\label{sec:win-filter-differences}

For resampling, the port can promise the same numbers as macOS because both sides run the same
explicit algorithm. For these five filters it can't. Core Image documents what its filters do,
not how: how many taps its Gaussian uses and how it handles large radii, the exact shape of its
box, the kernel behind its noise reduction. It also runs on the GPU, often with reduced
intermediate precision. The C\# filters follow the documented behavior with the simplest exact
algorithm, so a Gaussian blur of radius 2 looks the same on both systems, but profiles compared
pixel by pixel differ slightly, and noise reduction may differ visibly. A comparison \emph{between} methods on one machine is unaffected,
and that is what LineScope is for. The Windows [[README.md]] lists the same caveats for users.

\subsection{CPU filters}

The remaining filters are the CPU code of Chapter~\ref{ch:filters}, with the same kernels,
clamping and alpha handling. Two things change. The row loops are parallel. And the copy that
receives the output is made with [[Clone]]: in Swift, [[var out = src]] copied the struct and
copy-on-write duplicated the pixels at the first write, but with a class the same line would
alias the input and the filter would overwrite the image it is reading.

<<Win Filters: per-pixel color maps>>=
private static PixelBuffer MapRgb(PixelBuffer src, Func<Rgba, Rgba> f)
{
    var output = src.Clone();
    for (int y = 0; y < src.Height; y++)
        for (int x = 0; x < src.Width; x++)
            output[x, y] = f(src[x, y]);
    return output;
}
@
<<Win Filters: [[3x3]] convolution>>=
/// <summary>3×3 convolution on RGB with clamped edges; alpha is preserved.</summary>
internal static PixelBuffer Convolve3x3(PixelBuffer src, float[] k, bool absolute)
{
    var output = src.Clone();
    int w = src.Width, h = src.Height;
    var s = src.Data;
    var o = output.Data;
    Parallel.For(0, h, y =>
    {
        for (int x = 0; x < w; x++)
        {
            float a0 = 0, a1 = 0, a2 = 0;
            for (int ky = -1; ky <= 1; ky++)
            {
                int yy = Math.Clamp(y + ky, 0, h - 1);
                for (int kx = -1; kx <= 1; kx++)
                {
                    int xx = Math.Clamp(x + kx, 0, w - 1);
                    float wgt = k[(ky + 1) * 3 + (kx + 1)];
                    int i = (yy * w + xx) * 4;
                    a0 += s[i] * wgt;
                    a1 += s[i + 1] * wgt;
                    a2 += s[i + 2] * wgt;
                }
            }
            if (absolute) { a0 = MathF.Abs(a0); a1 = MathF.Abs(a1); a2 = MathF.Abs(a2); }
            int j = (y * w + x) * 4;
            o[j] = Math.Clamp(a0, 0, 1);
            o[j + 1] = Math.Clamp(a1, 0, 1);
            o[j + 2] = Math.Clamp(a2, 0, 1);
        }
    });
    return output;
}
@ The Swift code accumulated the three channels in tuples; C\# uses three named locals, which the
JIT keeps in registers just as well.

<<Win Filters: Sobel gradient magnitude>>=
/// <summary>Per-channel Sobel gradient magnitude.</summary>
internal static PixelBuffer Sobel(PixelBuffer src)
{
    float[] gx = [-1, 0, 1, -2, 0, 2, -1, 0, 1];
    float[] gy = [-1, -2, -1, 0, 0, 0, 1, 2, 1];
    var output = src.Clone();
    int w = src.Width, h = src.Height;
    var s = src.Data;
    var o = output.Data;
    Parallel.For(0, h, y =>
    {
        for (int x = 0; x < w; x++)
        {
            float sx0 = 0, sx1 = 0, sx2 = 0, sy0 = 0, sy1 = 0, sy2 = 0;
            for (int ky = -1; ky <= 1; ky++)
            {
                int yy = Math.Clamp(y + ky, 0, h - 1);
                for (int kx = -1; kx <= 1; kx++)
                {
                    int xx = Math.Clamp(x + kx, 0, w - 1);
                    int ki = (ky + 1) * 3 + (kx + 1);
                    int i = (yy * w + xx) * 4;
                    sx0 += s[i] * gx[ki]; sy0 += s[i] * gy[ki];
                    sx1 += s[i + 1] * gx[ki]; sy1 += s[i + 1] * gy[ki];
                    sx2 += s[i + 2] * gx[ki]; sy2 += s[i + 2] * gy[ki];
                }
            }
            int j = (y * w + x) * 4;
            o[j] = MathF.Min(MathF.Sqrt(sx0 * sx0 + sy0 * sy0), 1);
            o[j + 1] = MathF.Min(MathF.Sqrt(sx1 * sx1 + sy1 * sy1), 1);
            o[j + 2] = MathF.Min(MathF.Sqrt(sx2 * sx2 + sy2 * sy2), 1);
        }
    });
    return output;
}
@

