@ The two passes are the loops of Chapter~\ref{ch:resampling}, with the outer loop over rows
replaced by [[Parallel.For]]. Each iteration of the horizontal pass reads one source row and
writes one row of the intermediate image, so the iterations share nothing but read-only data, and
they can run on all cores without locks. Parallelism doesn't change the result: every output
component is still the same sum, accumulated in the same order, so the image is bit-identical
to that of a serial loop.

<<Win Resampler: horizontal pass>>=
// Horizontal pass: (src.Width x src.Height) -> (width x src.Height)
var tmp = new float[width * src.Height * 4];
Parallel.For(0, src.Height, y =>
{
    int srcRow = y * src.Width * 4;
    int dstRow = y * width * 4;
    for (int x = 0; x < width; x++)
    {
        var c = xContrib[x];
        float r = 0, g = 0, b = 0, a = 0;
        for (int k = 0; k < c.Weights.Length; k++)
        {
            float w = c.Weights[k];
            int si = srcRow + (c.Start + k) * 4;
            r += premul[si] * w;
            g += premul[si + 1] * w;
            b += premul[si + 2] * w;
            a += premul[si + 3] * w;
        }
        int di = dstRow + x * 4;
        tmp[di] = r;
        tmp[di + 1] = g;
        tmp[di + 2] = b;
        tmp[di + 3] = a;
    }
});
@ The vertical pass is parallel over \emph{output} rows. Each one accumulates several input rows,
and input rows are shared between neighboring output rows, but they are only read; every output
row is written by exactly one iteration. C\# arrays start out zeroed, so the accumulation needs no
explicit initialization, just as the Swift array created with [[repeating: 0]].

<<Win Resampler: vertical pass>>=
// Vertical pass: (width x src.Height) -> (width x height)
var output = new float[width * height * 4];
int rowStride = width * 4;
Parallel.For(0, height, y =>
{
    var c = yContrib[y];
    int dstRow = y * rowStride;
    for (int k = 0; k < c.Weights.Length; k++)
    {
        float w = c.Weights[k];
        int srcRow = (c.Start + k) * rowStride;
        for (int i = 0; i < rowStride; i++)
            output[dstRow + i] += tmp[srcRow + i] * w;
    }
});
