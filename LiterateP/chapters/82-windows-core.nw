@ Mean removal and windowing are written as loops where Swift called [[vDSP.mean]],
[[vDSP.add]], [[vDSP.multiply]] and [[vDSP.sum]]. The formulas are the same, but a sum computed
in a different order (vDSP's is vectorized, LINQ's [[Sum]] accumulates in [[double]]) can differ
in its last bits. This is the one place where a profile's spectrum may differ from macOS at all,
and only at the level of float rounding.

<<Win Spectrum: condition the signal>>=
var signal = (float[])values.Clone();
if (removeMean)
{
    float mean = signal.Sum() / n;
    for (int i = 0; i < n; i++) signal[i] -= mean;
}
float windowSum = n;
if (window == WindowFunction.Hann)
{
    // Symmetric Hann over the n real samples.
    windowSum = 0;
    for (int i = 0; i < n; i++)
    {
        float w = 0.5f - 0.5f * MathF.Cos(2 * MathF.PI * i / (n - 1));
        signal[i] *= w;
        windowSum += w;
    }
