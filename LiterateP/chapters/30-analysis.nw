@ \subsection{HSL}

With $M=\max(R,G,B)$, $m=\min(R,G,B)$ and chroma $d = M-m$, the standard definitions are
\[
  L = \frac{M+m}{2},\qquad
  S = \frac{d}{1-\lvert 2L-1\rvert},\qquad
  H = 60^\circ\times\begin{cases}
     \dfrac{G-B}{d} \bmod 6 & \text{if } M = R,\\[1ex]
     \dfrac{B-R}{d} + 2 & \text{if } M = G,\\[1ex]
     \dfrac{R-G}{d} + 4 & \text{if } M = B.
  \end{cases}
\]
A gray has $d=0$. Its hue is undefined, and it is reported as $0$ with zero saturation. The
remainder operation in Swift keeps the sign of its dividend, so a negative hue is brought back
into $[0^\circ,360^\circ)$ at the end. The saturation is clamped because rounding can push it a
hair outside $[0,1]$ when $L$ is close to $0$ or $1$.

Hue is circular, so a profile across a red area can jump between $0^\circ$ and $360^\circ$. The
spectrum then sees a sharp step that isn't really in the image. That's a property of hue itself,
and it's worth remembering when reading hue spectra.

<<ColorSpaces: RGB to HSL>>=
public static func hsl(from c: RGBA) -> (h: Float, s: Float, l: Float) {
    let maxV = max(c.r, c.g, c.b)
    let minV = min(c.r, c.g, c.b)
    let l = (maxV + minV) / 2
    let d = maxV - minV
    guard d > 1e-7 else { return (0, 0, l) }
    let s = d / (1 - abs(2 * l - 1))
    var h: Float
    if maxV == c.r {
        h = ((c.g - c.b) / d).truncatingRemainder(dividingBy: 6)
    } else if maxV == c.g {
        h = (c.b - c.r) / d + 2
    } else {
        h = (c.r - c.g) / d + 4
    }
    h *= 60
    if h < 0 { h += 360 }
    return (h, min(max(s, 0), 1), l)
}
@ The inverse builds the color from its chroma $C=(1-\lvert 2L-1\rvert)S$. With $H' = H/60^\circ$,
the second-largest component is $X = C\,(1-\lvert H' \bmod 2 - 1\rvert)$. The sextant
$\lfloor H'\rfloor$ decides which of $R,G,B$ receive $C$, $X$ and $0$. Finally the lightness
offset $m = L - C/2$ is added to all three.

<<ColorSpaces: HSL to RGB>>=
public static func rgb(h: Float, s: Float, l: Float, alpha: Float = 1) -> RGBA {
    let c = (1 - abs(2 * l - 1)) * s
    let hp = h / 60
    let x = c * (1 - abs(hp.truncatingRemainder(dividingBy: 2) - 1))
    let (r, g, b): (Float, Float, Float)
    switch hp {
    case ..<1: (r, g, b) = (c, x, 0)
    case ..<2: (r, g, b) = (x, c, 0)
    case ..<3: (r, g, b) = (0, c, x)
    case ..<4: (r, g, b) = (0, x, c)
    case ..<5: (r, g, b) = (x, 0, c)
    default: (r, g, b) = (c, 0, x)
    }
    let m = l - c / 2
    return RGBA(r: r + m, g: g + m, b: b + m, a: alpha)
}
@ \subsection{CMYK}

Real CMYK depends on inks and paper, and needs an ICC profile. LineScope uses the naive
conversion instead, which is enough to see how a filter treats the ``amount of black'' or of one
ink:
\[
  K = 1-\max(R,G,B),\qquad
  C = \frac{1-R-K}{1-K},\quad M = \frac{1-G-K}{1-K},\quad Y = \frac{1-B-K}{1-K}.
\]
Pure black ($K=1$) would divide by zero, so it is returned as $(0,0,0,1)$. The inverse is
$R=(1-C)(1-K)$, and likewise for $G$ and $B$.

<<ColorSpaces: RGB to CMYK and back>>=
public static func cmyk(from c: RGBA) -> (c: Float, m: Float, y: Float, k: Float) {
    let k = 1 - max(c.r, c.g, c.b)
    guard k < 1 - 1e-7 else { return (0, 0, 0, 1) }
    let d = 1 - k
    return ((1 - c.r - k) / d, (1 - c.g - k) / d, (1 - c.b - k) / d, k)
}

public static func rgb(c: Float, m: Float, y: Float, k: Float, alpha: Float = 1) -> RGBA {
    RGBA(r: (1 - c) * (1 - k), g: (1 - m) * (1 - k), b: (1 - y) * (1 - k), a: alpha)
}
@ The session calls this once per sample: it converts the color and picks the channel by its
index, in the order given by [[ColorModel.channels]].

<<ColorSpaces: channel extraction>>=
public static func value(of color: RGBA, model: ColorModel, channel: Int) -> Float {
    switch model {
    case .rgba:
        return [color.r, color.g, color.b, color.a][channel]
    case .hsl:
        let v = hsl(from: color)
        return [v.h, v.s, v.l][channel]
    case .cmyk:
        let v = cmyk(from: color)
        return [v.c, v.m, v.y, v.k][channel]
    }
}
@ \section{The spectrum}

The last step turns a profile of $n$ samples into an amplitude spectrum. It uses the FFT of
Apple's Accelerate framework (vDSP).

<<Packages/LineScopeCore/Sources/LineScopeCore/Spectrum.swift>>=
import Accelerate
import Foundation

<<Spectrum: window functions>>

<<Spectrum: result>>

<<Spectrum: analyzer>>
@ The DFT treats its input as one period of a periodic signal. The two ends of a profile rarely
match, so the implied periodic signal has a jump, and that jump leaks energy into every
frequency. A window tapers the ends to zero and trades a little frequency resolution for much
less leakage. LineScope offers no window (``rectangular'') and the Hann window~\cite{harris78},
\[
  w_i = \tfrac12 - \tfrac12\cos\frac{2\pi i}{n-1},\qquad i=0,\dots,n-1 .
\]

<<Spectrum: window functions>>=
public enum WindowFunction: String, CaseIterable, Identifiable, Sendable {
    case none
    case hann

    public var id: String { rawValue }
    public var displayName: String { self == .none ? "Rectangular" : "Hann" }
}
@ The result gives each bin's amplitude and two frequency axes. \emph{Cycles per pixel} are
measured in the grid of the sampled image, where the Nyquist limit is $\frac12$. \emph{Cycles
per line} count whole periods over the length of the line. The same image content has the same
cycles-per-line frequency in every copy, so that axis is the one for comparing an original with
its resampled copies. On that axis, each copy's Nyquist limit sits at half its own sample count.

The peak is searched among the non-DC bins. The mean usually dominates bin $0$ and is rarely
what one wants to find.

<<Spectrum: result>>=
public struct SpectrumResult: Sendable {
    /// Bin frequencies in cycles per pixel of the sampled image (Nyquist ≈ 0.5).
    public var cyclesPerPixel: [Double]
    /// Bin frequencies in cycles over the whole line; comparable across resampled copies.
    public var cyclesPerLine: [Double]
    /// Single-sided amplitude: a sine of amplitude A peaks at ≈ A.
    public var amplitudes: [Double]
    public var fftSize: Int
    public var sampleCount: Int

    public static let empty = SpectrumResult(cyclesPerPixel: [], cyclesPerLine: [], amplitudes: [], fftSize: 0, sampleCount: 0)

    /// Index of the largest non-DC bin.
    public var peakIndex: Int? {
        guard amplitudes.count > 1 else { return nil }
        return amplitudes.indices.dropFirst().max { amplitudes[$0] < amplitudes[$1] }
    }
}
