like [[.number.precision(.fractionLength(3))]] in Swift.

<<Win ZoneView: describing the line>>=
private string LineDescription()
{
    var l = _session.Line;
    static string P(double v) => Fmt.Fixed(v, 3);
    return $"({P(l.Start.X)}, {P(l.Start.Y)}) → ({P(l.End.X)}, {P(l.End.Y)})";
